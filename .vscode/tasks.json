{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Web App (Python Server)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/run_web.py"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Open Web App in Default Browser",
      "type": "process",
      "command": "xdg-open",
      "args": [
        "${workspaceFolder}/index.html"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build .NET WinForms (Windows/Wine)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/WinFormsApp1/WinFormsApp1.vbproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceConsoleColor",
        "/p:EnableWindowsTargeting=true"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
