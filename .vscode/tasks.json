{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Train Services (Desktop Application)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/main.py"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Run Train Services (Terminal Interactive CLI)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/main.py",
        "--cli"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    }
  ]
}
